# Optional: enables the Gemini-backed assistant path.
GEMINI_API_KEY=

# Required only when invoking protected maintenance POST routes from a trusted
# server-side script. Never send this value to the browser.
SAMZONE_ADMIN_API_KEY=

# Required for the production PostgreSQL profile.
PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=
